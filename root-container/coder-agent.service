[Unit]
Description=Coder Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=coder
WorkingDirectory=/home/coder
# The bootstrap script is generated by coder-agent-env.service.
ExecStart=/bin/bash /usr/local/bin/coder-agent-init.sh
Restart=always
RestartSec=5
TimeoutStartSec=0
EnvironmentFile=/etc/coder-agent.env

[Install]
WantedBy=multi-user.target
